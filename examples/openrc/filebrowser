#!/sbin/openrc-run

name="UnyCloud"
description="UnyCloud, a maintained File Browser fork"
supervisor="supervise-daemon"
command="/usr/local/bin/filebrowser"
command_user="filebrowser:filebrowser"
command_args="--database /var/lib/filebrowser/database.db --log /var/log/filebrowser/filebrowser.log"
directory="/"
pidfile="/run/filebrowser.pid"
respawn_delay=5
respawn_max=0

depend() {
    need net
    after firewall
}
